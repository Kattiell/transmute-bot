# =============================================================
# transmute-bot — environment
# =============================================================
# Copy to `.env` (local) or set in the Vercel project (deployed).
# `.env` is gitignored; this file must never contain real values.

# --- Telegram -------------------------------------------------
# Bot API token from @BotFather. The single most sensitive value here: it
# authenticates the bot AND is the HMAC key that makes Mini App `initData`
# verifiable. The nous-app deployment needs the SAME token for
# POST /api/tma/session — keep them in sync.
TELEGRAM_BOT_TOKEN=

# Protects GET /api/set-webhook so a stranger cannot repoint the webhook
# (DoS) or flush queued updates.
WEBHOOK_SECRET=

# Echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token on every webhook
# delivery, so the handler can reject forged calls.
TELEGRAM_WEBHOOK_SECRET=

# --- Telegram Mini App ---------------------------------------
# HTTPS URL of the Mini App. This is a route inside the Transmute App
# (nous-app), NOT a separate frontend — it reuses the existing RainbowKit +
# wagmi stack, iron-session and $TRANSMUTE gate.
#
# MUST be https:// — Telegram rejects `web_app` buttons on any other scheme,
# and wallet connection needs a secure context anyway. An unset or non-https
# value simply hides the Mini App buttons; the bot keeps working.
#
# Powers: the /start button, the /app command, and the chat menu button
# (registered by GET /api/set-webhook).
TELEGRAM_MINI_APP_URL=https://transmute.app/tma

# --- Inference ------------------------------------------------
VENICE_API_KEY=
# Optional overrides — see src/grok.ts
VENICE_BASE_URL=
VENICE_MODEL=
VENICE_ORACLE_MODEL=
VENICE_ORACLE_EFFORT=

# --- Explorers / data -----------------------------------------
BASESCAN_API_KEY=

# --- Token gate -----------------------------------------------
GATE_TOKEN_ADDRESS=0x557E8f1cd9fB4e9dfEcA817b15B737328D90821A
GATE_MIN_BALANCE=100000000
GATE_CHAIN_ID=8453
GATE_LINK_BASE_URL=https://transmute.app

# Daily quota per Telegram user, per command (independent counters, 00:00 UTC).
# NOTE: GATE_INVOKE_DAILY_LIMIT / GATE_INVOKERH_DAILY_LIMIT are gone — /invoke
# and /invokeRH were removed from the bot when the Oracle hunt went systemic
# (the admin broadcasts from the Transmute App to every user's timeline).
GATE_ORACLE_DAILY_LIMIT=1
GATE_CALLNOW_DAILY_LIMIT=3

# God-mode wallets: bypass the balance gate and every premium daily limit.
# Mirrored in nous-app/src/lib/gate-exempt.ts — keep both in sync.
GATE_EXEMPT_WALLETS=

# Telegram user IDs allowed to approve/reject Pantheon calls (comma-separated).
ADMIN_TELEGRAM_IDS=

# --- RPC ------------------------------------------------------
# Base failover stack (defaults to the public endpoints when unset).
BASE_RPC_1=
BASE_RPC_2=
BASE_RPC_3=
# Robinhood Chain (still used by /oracle CA and the CA cards).
ROBINHOOD_RPC_URL=
ROBINHOOD_CHAIN_ID=

# --- Supabase -------------------------------------------------
# SUPABASE_URL is read first; NEXT_PUBLIC_SUPABASE_URL is the fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron -----------------------------------------------------
# Bearer secret for the scheduled endpoints (api/cron-*).
CRON_SECRET=

# --- Bridge to the Transmute App ------------------------------
# Where the app lives. Used by /invoke to trigger the SYSTEMIC broadcast on the
# site (POST /api/internal/oracle/broadcast) instead of hunting locally, so the
# daily cap and concurrency guard are shared between the site button and the
# Telegram command. NOT ARENA_BOT_INTERNAL_URL — that one points the other way.
SITE_BASE_URL=https://transmute-ten.vercel.app

# Shared bot<->site secret. Must be IDENTICAL on both deployments: the app
# authenticates the /invoke bridge with it. Already used by the arena push
# channel, which is why /invoke reuses it rather than minting a third secret.
ARENA_BOT_INTERNAL_SECRET=
